# Supabase — must be https://<project-ref>.supabase.co (NOT your app domain like onesourcefresh.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override for Supabase redirect allow-list (must match Dashboard exactly)
# SUPABASE_AUTH_REDIRECT_URL=https://onesourcefresh.com/auth/callback
NEXT_PUBLIC_APP_NAME=OneSource

# File storage
# Local dev — files saved under ./uploads (default when SUPABASE_STORAGE_BUCKET is unset)
UPLOAD_DIR=./uploads
SIGNATURES_DIR=./uploads/signatures
ATTACHMENTS_DIR=./uploads/attachments
LOGOS_DIR=./uploads/logos
# Production (Vercel) — use Supabase Storage instead of local disk (run migration 015)
SUPABASE_STORAGE_BUCKET=ememo-files

# Email — required for password reset, welcome, and memo notifications
# Without SMTP_HOST, in-app notifications still work; transactional emails are skipped (logged in dev).
SMTP_HOST=mail.one-sourcebrand.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER must match the From domain (SPF). Same address is best for Outlook inbox placement.
SMTP_USER=noreply@one-sourcebrand.com
SMTP_PASS=your-email-account-password
SMTP_FROM="OneSource <noreply@one-sourcebrand.com>"
SMTP_REPLY_TO=your system administrator
# Outlook Focused inbox: ensure SPF + DKIM + DMARC on one-sourcebrand.com (ask IT/mail host).
# Ask M365 admin to add a transport rule: mail from noreply@one-sourcebrand.com → bypass spam (SCL -1).
# Staff can also right-click one message → Move to Focused → Always move here.
# Use your public app URL so links in email work (images are embedded inline).
# Production (required on Vercel — all live emails and portal links use this):
# NEXT_PUBLIC_APP_URL=https://onesourcefresh.com
# Optional override when running npm run send:launch from a dev machine:
# LAUNCH_EMAIL_APP_URL=https://onesourcefresh.com

# Testing — one password for all seeded users (run: npm run test:password)
# TEST_UNIFIED_PASSWORD=Test@OneSource2026

# Session — REQUIRED on Vercel (signs login cookie for API routes e.g. signature upload)
# Generate: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string

# Cron — hourly SLA reminders (e.g. curl "/api/cron/sla?secret=YOUR_SECRET")
CRON_SECRET=change-this-cron-secret
